{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "themes": [
    {
      "repo": "rj-nexus/spotlight",
      "name": "Spotlight",
      "author": "rj-nexus",
      "version": "1.0.4",
      "verified": true,
      "featured": true,
      "category": "general",
      "tags": ["dark", "glassmorphism", "ai", "saas", "premium"],
      "logo": "https://raw.githubusercontent.com/rj-nexus/spotlight/main/screenshot.png",
      "screenshots": [
        "https://raw.githubusercontent.com/rj-nexus/spotlight/main/screenshot-1.png",
        "https://raw.githubusercontent.com/rj-nexus/spotlight/main/screenshot-2.png"
      ],
      "details": {
        "description": "A dark, modern, builder-first theme designed for SaaS platforms, AI products, and digital agencies.",
        "features": [
          "20+ custom premium widgets",
          "Animated glassmorphism UI",
          "Dark mode map and contact forms",
          "Auto-import starter content on activation"
        ]
      },
      "installation": {
        "steps": [
          "Download the ZIP from the releases page",
          "Go to Admin → Appearance → Themes",
          "Upload the ZIP file",
          "Click Activate"
        ]
      },
      "development": {
        "requires": "RJ Nexus >= 1.8.6",
        "docs": "https://github.com/rj-nexus/spotlight#readme"
      }
    },
    {
      "repo": "mr-ruhid/rj-theme-default",
      "name": "RJ Default",
      "author": "mr-ruhid",
      "version": "1.0.2",
      "verified": true,
      "featured": false,
      "category": "general",
      "tags": ["minimal", "blog"],
      "logo": "https://raw.githubusercontent.com/mr-ruhid/rj-theme-default/main/screenshot.png",
      "screenshots": [
        "https://raw.githubusercontent.com/mr-ruhid/rj-theme-default/main/screenshot-1.png"
      ],
      "details": {
        "description": "The default RJ Nexus theme. Clean, minimal and fast, built for blogs and content sites.",
        "features": [
          "Minimal and clean design",
          "Fully responsive",
          "RJBuilder ready",
          "Optimized for performance"
        ]
      },
      "installation": {
        "steps": [
          "Download the ZIP from the releases page",
          "Go to Admin → Appearance → Themes",
          "Upload the ZIP file",
          "Click Activate"
        ]
      },
      "development": {
        "requires": "RJ Nexus >= 1.8.0",
        "docs": "https://github.com/mr-ruhid/rj-theme-default#readme"
      }
    },
    {
      "repo": "rj-nexus/velvet-aura",
      "name": "Velvet Aura",
      "author": "rj-nexus",
      "version": "1.0.3-beta",
      "verified": true,
      "featured": true,
      "category": "general",
      "tags": ["minimal", "shop"],
      "logo": "https://raw.githubusercontent.com/rj-nexus/velvet-aura/main/screenshot.png",
      "screenshots": [
        "https://raw.githubusercontent.com/rj-nexus/velvet-aura/main/screenshot-1.png"
      ],
      "details": {
        "description": "A premium theme with elegant typography, custom widgets and full RJBuilder support.",
        "features": [
          "Premium widget collection",
          "Custom color presets",
          "Full builder integration",
          "Optimized for commerce"
        ]
      },
      "installation": {
        "steps": [
          "Download the ZIP from the releases page",
          "Go to Admin → Appearance → Themes",
          "Upload the ZIP file",
          "Click Activate"
        ]
      },
      "development": {
        "requires": "RJ Nexus >= 1.8.0",
        "docs": "https://github.com/rj-nexus/velvet-aura#readme"
      }
    }
  ]
}
